# ─────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values
#   cp terraform.tfvars.example terraform.tfvars
# ─────────────────────────────────────────────

# General
project_name = "taxonomy"
environment  = "production"
aws_region   = "us-east-1"

# VPC
vpc_cidr = "10.0.0.0/16"

# EKS
cluster_version            = "1.29"
system_node_instance_types = ["t3.medium"]
system_node_min_size       = 2
system_node_max_size       = 4
system_node_desired_size   = 2

# RDS
db_instance_class        = "db.t3.medium"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_name                  = "taxonomy"
db_username              = "taxonomy_admin"
db_multi_az              = true

# Domain
domain_name = "taxonomy.example.com"

# CloudFront SSL cert (must be in us-east-1)
cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:541405370428:certificate/PENDING"
